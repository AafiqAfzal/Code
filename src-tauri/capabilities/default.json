{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Oprávnění hlavního okna: zálohy jen do Dokumenty/Pedagogický deník, dialogy, oznámení, aktualizace",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "dialog:default",
    "notification:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [{ "path": "$DOCUMENT/Pedagogický deník/zalohy" }]
    },
    "process:default",
    "updater:default",
    "fs:deny-default",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:allow-read-dir",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-rename",
    "fs:allow-remove",
    {
      "identifier": "fs:scope",
      "allow": [{ "path": "$DOCUMENT/Pedagogický deník" }, { "path": "$DOCUMENT/Pedagogický deník/**" }]
    }
  ]
}
